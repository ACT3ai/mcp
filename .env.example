# ACT3 MCP server configuration. Every setting is optional; the defaults target production.
#
# act3-mcp does NOT read a .env file. This is a reference for the variables it
# takes from the environment. Either `export` them in your shell (or fill this
# in and `source` it), or attach them to the Claude Code registration so they
# are set when it launches the server:
#     claude mcp add act3-local -s user -e ACT3_API_URL=... -- act3-mcp serve
# or the "env" block in .mcp.json. Each variable also has a flag form, given
# after the subcommand: act3-mcp status --api-url ...
#
# End users normally need none of this — `act3-mcp login` is enough.

# Which ACT3 to talk to. This build has one mode, production (the default).
# ACT3_MODE=production

# Base URL of the ACT3 backend API (default: https://api.act3ai.com).
# Must be https://. The one exception is http:// to this machine
# (localhost / 127.0.0.1) for a backend running locally.
# ACT3_API_URL=https://api.act3ai.com

# Base URL of the ACT3 dashboard, where the login screen lives. Default: derived
# from ACT3_API_URL (api. -> app.; a localhost URL is used as-is). Set it when
# the dashboard is on a different host or port than the API.
# ACT3_APP_URL=https://app.act3ai.com

# API key. Prefer `act3-mcp login` (stores it in ~/.act3/credentials.json).
# Setting this env var overrides the stored credentials — useful for CI.
# ACT3_API_KEY=

# Override where credentials are stored (default: ~/.act3/credentials.json).
# A credential is bound to the backend that issued it, so give a local backend
# its own directory instead of overwriting your production login.
# ACT3_CONFIG_DIR=~/.act3

# Log level: error | warn | info | debug (default: info). Logs go to stderr.
# ACT3_LOG_LEVEL=info

# Example: a backend running on this machine, kept apart from production.
# ACT3_API_URL=http://localhost:8080
# ACT3_APP_URL=http://localhost:8081
# ACT3_CONFIG_DIR=~/.act3-local
